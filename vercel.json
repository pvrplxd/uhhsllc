{
  "rewrites": [
    {
      "source": "/wp-content/plugins/elementor/assets/lib/font-awesome/css/webfonts/:file",
      "destination": "/wp-content/plugins/elementor/assets/lib/font-awesome/webfonts/:file"
    }
  ],
  "headers": [
    {
      "source": "/wp-content/plugins/elementor/assets/lib/font-awesome/webfonts/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/wp-content/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}